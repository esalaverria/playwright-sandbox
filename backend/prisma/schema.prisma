generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
}

enum LedgerStatus {
  POSTED
  PENDING
}

enum PaymentStatus {
  SCHEDULED
  PAID
  FAILED
}

enum CardBrand {
  VISA
  MASTERCARD
}

enum CardLifecycleStatus {
  ACTIVE
  CANCELLED
  LOST_REPORTED
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String
  fullName            String
  phone               String?
  locked              Boolean  @default(false)
  emailVerified       Boolean  @default(true)
  createdAt           DateTime @default(now())
  accounts            Account[]
  payees              Payee[]
  scheduledPayments   ScheduledPayment[]
  messages            Message[]
  activities          UserActivity[]
}

model Account {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               AccountType
  nickname           String
  mask               String
  currency           String     @default("USD")
  balanceCents       Int        @default(0)
  frozen             Boolean    @default(false)
  creditLimitCents   Int?
  allowOverLimit     Boolean    @default(false)
  createdAt          DateTime   @default(now())
  /// Soft-close: account excluded from normal lists when set.
  closedAt           DateTime?
  /// Fake full account number for deposit accounts (UI reveal).
  accountNumberFull  String?
  cardBrand          CardBrand?
  cardLifecycle      CardLifecycleStatus @default(ACTIVE)
  panFull            String?
  cvv                String?
  expMonth           Int?
  expYear            Int?
  nameOnCard         String?
  ledgerEntries      LedgerEntry[]
  scheduledPaymentsFrom ScheduledPayment[]
}

model LedgerEntry {
  id                String       @id @default(cuid())
  accountId         String
  account           Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  occurredAt        DateTime     @default(now())
  description       String
  amountCents       Int
  balanceAfterCents Int
  status            LedgerStatus @default(POSTED)
}

model Payee {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  nickname    String?
  externalRef String
  createdAt   DateTime @default(now())
}

model ScheduledPayment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  billerName     String
  fromAccountId  String
  fromAccount    Account       @relation(fields: [fromAccountId], references: [id])
  amountCents    Int
  dueDate        DateTime
  status         PaymentStatus @default(SCHEDULED)
  memo           String?
}

model Message {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
