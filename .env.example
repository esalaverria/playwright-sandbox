# Copy to `.env` if needed for local tooling (Docker Compose reads env from shell or compose file).

# PostgreSQL (host machine tools: psql, DBeaver)
POSTGRES_USER=northpeak
POSTGRES_PASSWORD=northpeak
POSTGRES_DB=northpeak
# Host URL when connecting from your laptop:
DATABASE_URL_HOST=postgresql://northpeak:northpeak@localhost:5432/northpeak

# Inside Docker network (API container):
DATABASE_URL=postgresql://northpeak:northpeak@postgres:5432/northpeak

JWT_SECRET=dev-jwt-secret-change-in-prod
WEB_ORIGIN=http://localhost:3000
ALLOW_REGISTRATION=true

# Playwright / E2E (seeded personas share password Test123!)
E2E_EMAIL=alice@example.com
E2E_PASSWORD=Test123!
E2E_BOB_EMAIL=bob@example.com
E2E_LOCKED_EMAIL=carol@example.com
E2E_DUPLICATE_EMAIL=eve@example.com
